            {
              "listen": "test",
              "script": {
                "exec": [
                  "const products = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Products are available\", function () {\r",
                  "    pm.expect(products).to.be.an(\"array\").and.not.empty;\r",
                  "});\r",
                  "\r",
                  "const selectedProduct = products[0];\r",
                  "\r",
                  "pm.environment.set(\"dynamicProductId\", selectedProduct.id);\r",
                  "\r",
                  "pm.test(\"Dynamic productId was stored\", function () {\r",
                  "    pm.expect(pm.environment.get(\"dynamicProductId\")).to.exist;\r",
                  "});"
                ],
