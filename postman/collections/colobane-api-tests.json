    {
      "name": "Products",
      "item": [
        {
          "name": "Get All Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 1. Vérifier le code HTTP\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// 2. Vérifier le temps de réponse\r",
                  "pm.test(\"Response time is less than 2000ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
                  "});\r",
                  "\r",
                  "// 3. Vérifier le Content-Type\r",
                  "pm.test(\"Content-Type is application/json\", function () {\r",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\"))\r",
                  "        .to.include(\"application/json\");\r",
                  "});\r",
                  "\r",
                  "// Récupérer la réponse JSON\r",
                  "const products = pm.response.json();\r",
                  "\r",
                  "// 4. Vérifier que la réponse est un tableau\r",
                  "pm.test(\"Response is an array\", function () {\r",
                  "    pm.expect(products).to.be.an(\"array\");\r",
                  "});\r",
                  "\r",
                  "// 5. Vérifier que le tableau contient des produits\r",
                  "pm.test(\"Products list is not empty\", function () {\r",
                  "    pm.expect(products.length).to.be.above(0);\r",
                  "});\r",
                  "\r",
                  "// 6. Vérifier les champs obligatoires de chaque produit\r",
                  "pm.test(\"Each product has the required fields\", function () {\r",
                  "    products.forEach(function (product) {\r",
                  "        pm.expect(product).to.have.property(\"id\");\r",
                  "        pm.expect(product).to.have.property(\"title\");\r",
                  "        pm.expect(product).to.have.property(\"price\");\r",
                  "        pm.expect(product).to.have.property(\"category\");\r",
                  "    });\r",
                  "});\r",
                  "\r",
                  "// 7. Vérifier les valeurs des données\r",
                  "pm.test(\"Product data is valid\", function () {\r",
                  "    products.forEach(function (product) {\r",
                  "        pm.expect(product.id).to.exist;\r",
                  "        pm.expect(product.title).to.be.a(\"string\").and.not.empty;\r",
                  "        pm.expect(product.price).to.be.above(0);\r",
                  "        pm.expect(product.category).to.be.a(\"string\").and.not.empty;\r",
                  "\r",
                  "        if (product.rating && product.rating.rate !== undefined) {\r",
                  "            pm.expect(product.rating.rate).to.be.within(0, 5);\r",
                  "        }\r",
                  "    });\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            }
          },
          "response": []
        },
